@model List<Problema>

<div class="text-center mb-4">
    <h1 class="fw-bold">Consultoria em Desenvolvimento</h1>
    <p class="text-muted">Escolha um problema e solicite nossa solução 🚀</p>
</div>

@if (TempData["msg"] != null)
{
    <div class="alert alert-success text-center">@TempData["msg"]</div>
}

<div class="row justify-content-center">
    @foreach (var item in Model)
    {
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4 m-3">
                <div class="card-body text-center">
                    <h4 class="fw-bold">@item.Nome</h4>
                    <p class="text-muted">@item.Descricao</p>

                    <p class="badge bg-info text-dark p-2">
                        ⏱ @item.TempoResposta horas
                    </p>

                    <br />

                    <a href="/Home/Solicitar/@item.Id"
                           class="btn btn-primary w-100 mt-3 rounded-pill">
                        Solicitar
                    </a>
                </div>
            </div>
        </div>
    }
</div>